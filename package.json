{
  "name": "dsh-audio-alert",
  "version": "0.2.0",
  "description": "Host-side alert sounds for DeepSeek Harness on Linux: a chime when a turn ends, distinct tones for errors, and repeating reminders while an approval or question waits — browser not required.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "sounds",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "audio",
    "alert",
    "pipewire",
    "pulseaudio",
    "alsa"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
