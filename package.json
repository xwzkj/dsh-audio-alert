{
  "name": "dsh-audio-alert",
  "version": "0.2.0",
  "description": "Host-side alert sounds for DeepSeek Harness on Linux: a chime when a turn ends, distinct tones for errors, and repeating reminders while an approval or question waits — browser not required.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "sounds",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "test-alert.sh"
  ],
  "scripts": {
    "test": "node --test",
    "check:pack": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "audio",
    "alert",
    "sound",
    "chime",
    "approval",
    "linux",
    "pipewire",
    "pulseaudio",
    "alsa"
  ],
  "author": "wanzii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xwzkj/dsh-audio-alert.git"
  },
  "homepage": "https://github.com/xwzkj/dsh-audio-alert#readme",
  "bugs": {
    "url": "https://github.com/xwzkj/dsh-audio-alert/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
